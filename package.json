{
  "name": "skill-master",
  "scope": "@the-long-ride",
  "version": "1.0.0",
  "description": "A routed skill-design catalog for AI agents, installed with one /skill-master entry point.",
  "keywords": [
    "agent-skill",
    "ai-agent",
    "agent-skills",
    "codex",
    "claude",
    "slash-command",
    "skill-master"
  ],
  "homepage": "https://github.com/the-long-ride/skill-master#readme",
  "bugs": {
    "url": "https://github.com/the-long-ride/skill-master/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-long-ride/skill-master.git"
  },
  "license": "MIT",
  "author": "the-long-ride",
  "type": "commonjs",
  "main": "index.js",
  "bin": {
    "skill-master": "bin/skill-master.js"
  },
  "directories": {
    "doc": "docs"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "GUIDELINE.md",
    "LICENSE",
    "README.md",
    "bin/",
    "commands/skill-master.md",
    "docs/",
    "scripts/",
    "skill-index.json",
    "skills/",
    "src/",
    "templates/"
  ],
  "scripts": {
    "test": "node bin/skill-master.js doctor .",
    "verify": "node bin/skill-master.js verify .",
    "verify:node": "node scripts/verify-skills.js",
    "verify:posix": "sh scripts/verify-skills.sh",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
